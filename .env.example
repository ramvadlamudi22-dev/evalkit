# EvalKit environment variables.
# Copy to .env (gitignored) for local use. Never commit real secrets.

# --- Provider credentials (Phase 2+) -------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_HOST=http://localhost:11434

# --- Storage ------------------------------------------------------------
# EVALKIT_DB=~/.evalkit/evalkit.db

# --- Logging ------------------------------------------------------------
# EVALKIT_LOG_LEVEL=INFO
# EVALKIT_LOG_FORMAT=auto    # auto | json | console

# --- Observability (Phase 5+) -------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=evalkit
# EVALKIT_TELEMETRY_DISABLED=1   # hard kill switch
